              "id": "CWE-538",
              "name": "Exposed High-Value Asset in Attack Surface: .env",
              "shortDescription": {
                "text": "Exposed High-Value Asset in Attack Surface: .env"
              },
              "fullDescription": {
                "text": "Sensitive asset `.env` was committed into repository root."
              },
              "helpUri": "https://owasp.org",
              "help": {
                "text": "Remediation: Add to .gitignore, delete file from repository history, and inject via environment variables.",
                "markdown": "### Remediation Guidance\nAdd to .gitignore, delete file from repository history, and inject via environment variables.\n\n*References:*\n"
              },
              "properties": {
